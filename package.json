{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/check-punctuation.mjs && node scripts/check-english-only.mjs && tsc --noEmit",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:seed": "node scripts/seed-demo.mjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "security:check": "node scripts/security-check.mjs",
    "db:maintenance": "node scripts/maintenance.mjs",
    "admin:promote": "node scripts/promote-admin.mjs",
    "showcase:seed-demo": "node scripts/seed-showcase-demo.mjs",
    "db:seed:hackathons": "node scripts/seed-hackathons-2026.mjs",
    "check:punctuation": "node scripts/check-punctuation.mjs",
    "content:scan-polish": "node scripts/translate-existing-content-to-english.mjs",
    "content:translate-en": "node scripts/translate-existing-content-to-english.mjs --apply",
    "content:restore": "node scripts/restore-content-backup.mjs",
    "check:english-only": "node scripts/check-english-only.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.30.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.84.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
