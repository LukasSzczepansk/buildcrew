# One BuildCrew deployment, two domains, one database.
# Replace the .pl URL below if your production domain is different.
NEXT_PUBLIC_APP_URL=https://buildcreww.pl
NEXT_PUBLIC_APP_URL_PL=https://buildcreww.pl
NEXT_PUBLIC_APP_URL_EN=https://buildcreww.com
NEXT_PUBLIC_DEFAULT_LOCALE=pl

# Existing variables stay unchanged, for example:
# DATABASE_URL=...
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# RESEND_API_KEY=...
# EMAIL_FROM=BuildCrew <hello@buildcreww.pl>
# CRON_SECRET=...
